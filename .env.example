# ═══════════════════════════════════════════════════════════════════
#  Hedera Agent Commerce Kit — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════════


# ─── Hedera Operator ────────────────────────────────────────────────
# Your Hedera testnet account credentials.
# Get a free account at https://portal.hedera.com
# The operator account pays for HCS receipt submissions.

HEDERA_OPERATOR_ID=0.0.XXXXXX
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...

# Hedera network: testnet (default) or mainnet
HEDERA_NETWORK=testnet


# ─── Payment Receiver ───────────────────────────────────────────────
# The Hedera account that receives HBAR payments from clients.
# Usually the same as your operator account for demos.
# Must match the account your wallet/agent is sending to.

X402_PAYMENT_RECEIVER_ACCOUNT_ID=0.0.XXXXXX

# Amount charged per request (in HBAR)
X402_PAYMENT_AMOUNT_HBAR=0.5

# Memo that clients should include in their HBAR transfer
X402_PAYMENT_MEMO=hack-payment


# ─── HCS Receipt Topic ──────────────────────────────────────────────
# Every verified payment publishes an immutable receipt to this topic.
# Create a topic: https://portal.hedera.com → Console → HCS
# Or run: python scripts/create_topic.py

HCS_RECEIPT_TOPIC_ID=0.0.XXXXXX


# ─── LLM Provider ───────────────────────────────────────────────────
# The Hedera Agent Kit agent needs an LLM to reason over Hedera tools.
# Fill in exactly ONE of the following. Leave the others blank.
#
#  OpenAI:    https://platform.openai.com/api-keys
#  Anthropic: https://console.anthropic.com/
#  Groq:      https://console.groq.com  ← free tier, great for demos

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=


# ─── Backend Server ─────────────────────────────────────────────────
# Change these if port 8000 is already in use.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000


# ─── Frontend ───────────────────────────────────────────────────────
# The Next.js frontend uses this to reach the backend.
# Change if you deploy to a non-local URL.

NEXT_PUBLIC_API_URL=http://localhost:8000
