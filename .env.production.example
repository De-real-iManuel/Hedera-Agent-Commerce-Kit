# HACK backend production environment template
# Copy these values into your backend host's secret/env manager.
# Do NOT commit real secrets.

# ── Backend server ───────────────────────────────────────────────────────────
PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=https://your-frontend-domain.example.com
# Alternative for multiple deployed frontends:
# CORS_ALLOW_ORIGINS=https://your-frontend-domain.example.com,https://preview.example.com

# ── Hedera operator ──────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.YOUR_OPERATOR_ACCOUNT
HEDERA_OPERATOR_KEY=YOUR_OPERATOR_PRIVATE_KEY

# ── x402 payment receiver ───────────────────────────────────────────────────
X402_PAYMENT_RECEIVER_ACCOUNT_ID=0.0.YOUR_RECEIVER_ACCOUNT
X402_PAYMENT_AMOUNT_HBAR=0.5
X402_PAYMENT_MEMO=hack-payment

# ── HCS receipt topic ────────────────────────────────────────────────────────
HCS_RECEIPT_TOPIC_ID=0.0.YOUR_TOPIC_ID

# ── Soulbound NFT collection ─────────────────────────────────────────────────
# Leave blank to auto-create on first passing certification.
# If blank, make sure HACK_STATE_FILE points to persistent storage.
HACK_NFT_TOKEN_ID=
HACK_NFT_TOKEN_NAME=HACK Compliance Certificate
HACK_NFT_TOKEN_SYMBOL=HACKCERT
HACK_STATE_FILE=/app/state/.hack_state.json

# ── Mirror Node ──────────────────────────────────────────────────────────────
# Blank uses the default public mirror node for HEDERA_NETWORK.
MIRROR_NODE_URL=

# ── Payment state TTLs ───────────────────────────────────────────────────────
QUOTE_TTL_SECONDS=600
GRANT_TTL_SECONDS=300

# ── LLM provider (Groq OpenAI-compatible recommended) ────────────────────────
GROQ_API_KEY=YOUR_GROQ_API_KEY
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
# Optional aliases/fallbacks:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# ── Service audit engine ─────────────────────────────────────────────────────
COMPLIANCE_STORE_DIR=/app/data/reports
COMPLIANCE_PROBE_TIMEOUT_SEC=15
# Optional, only needed for GitHub API rate limits/private repos:
GITHUB_TOKEN=
