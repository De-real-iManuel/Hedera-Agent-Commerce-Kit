# ─── Backend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── Hedera network ───────────────────────────────────────────────────────────
NEXT_PUBLIC_HEDERA_NETWORK=testnet
NEXT_PUBLIC_HASHSCAN_BASE=https://hashscan.io/testnet

# ─── Hedera accounts (testnet) ────────────────────────────────────────────────
# The account that RECEIVES x402 payments (matches X402_PAYMENT_RECEIVER_ACCOUNT_ID in backend .env)
NEXT_PUBLIC_PAYMENT_RECEIVER=0.0.XXXXXX

# ─── HCS receipt topic ────────────────────────────────────────────────────────
# The HCS topic where payment receipts are logged (matches HCS_RECEIPT_TOPIC_ID in backend .env)
NEXT_PUBLIC_HCS_TOPIC_ID=0.0.YYYYYY

# ─── WalletConnect ────────────────────────────────────────────────────────────
# Get a free project ID at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
